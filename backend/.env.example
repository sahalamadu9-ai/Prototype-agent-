# Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zapcart

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API
PORT=3000
NODE_ENV=development

# AI Providers
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4

# Image Providers
DALLE_API_KEY=your-dalle-key

# Voice Providers
ELEVENLABS_API_KEY=your-elevenlabs-key

# Video Providers
RUNWAY_API_KEY=your-runway-key

# Storage
AWS_S3_BUCKET=your-bucket
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

# Payment
PAYSTACK_PUBLIC_KEY=your-paystack-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-key

# Social Media
INSTAGRAM_ACCESS_TOKEN=your-token
TIKTOK_ACCESS_TOKEN=your-token
YOUTUBE_API_KEY=your-key
